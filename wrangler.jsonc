{
"$schema": "node_modules/wrangler/config-schema.json",
"name": "usa-work-kit",
"main": "server/worker.mjs",
"compatibility_date": "2026-11-17",
"workers_dev": true,
"assets": {
"directory": "./usa-work-kit",
"binding": "ASSETS",
"run_worker_first": ["/api/*"]
},
"d1_databases": [
{
"binding": "DB",
"database_name": "usa-work-kit-db",
"database_id": "f1bc1f76-ba3d-4ed6-9b7b-de99f2f9a164"
}
],
"triggers": {
"crons": ["17 * * * *"]
},
"observability": {
"enabled": false
}
}
